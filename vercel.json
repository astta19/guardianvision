{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,
  "functions": {
    "api/chat.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/chat-anthropic.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/supabase-proxy.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/notificacoes-prazos.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/portal.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/recaptcha-verify.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/recaptcha-config.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/indicadores.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/notificacoes-prazos",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.google.com/recaptcha https://www.gstatic.com/recaptcha https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.groq.com https://brasilapi.com.br https://viacep.com.br https://receitaws.com.br https://api.bcb.gov.br https://www.google.com https://www.gstatic.com https://api.anthropic.com https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://*.sentry.io https://o4511079688503296.ingest.us.sentry.io https://browser.sentry-cdn.com; img-src 'self' data: blob: https://*.supabase.co; frame-ancestors 'none'; frame-src https://www.google.com/recaptcha https://recaptcha.google.com; media-src blob: mediastream:"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/((?!api/|assets/|landing\\.html$|index\\.html$|portal\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
